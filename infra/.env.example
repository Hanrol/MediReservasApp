# Genera un valor distinto con openssl rand -hex 24 para cada contraseña.
AUTH_DB_PASSWORD=CAMBIAR
USERS_DB_PASSWORD=CAMBIAR
DOCTORS_DB_PASSWORD=CAMBIAR
APPOINTMENTS_DB_PASSWORD=CAMBIAR
MEDICAL_RECORDS_DB_PASSWORD=CAMBIAR
MASTER_ADMIN_PASSWORD=CAMBIAR
# Genera este secreto con openssl rand -hex 32.
JWT_SECRET=CAMBIAR

DOCKERHUB_USER=benjamincubillosduoc
