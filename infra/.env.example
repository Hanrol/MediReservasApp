# El instalador completa estos tres valores públicos desde CloudFormation.
RDS_ENDPOINT=CAMBIAR_ENDPOINT_RDS
RDS_MASTER_USERNAME=medires_admin
DUCKDNS_SUBDOMAIN=crispardos

# Misma contraseña que ingresaste al crear el stack: mínimo 8, letras y números.
RDS_MASTER_PASSWORD=CAMBIAR
# Token privado de DuckDNS y correo para el certificado HTTPS.
DUCKDNS_TOKEN=CAMBIAR
LETSENCRYPT_EMAIL=CAMBIAR

# Claves de las bases de datos: sin longitud mínima; solo letras, números o _.
AUTH_DB_PASSWORD=CAMBIAR
USERS_DB_PASSWORD=CAMBIAR
DOCTORS_DB_PASSWORD=CAMBIAR
APPOINTMENTS_DB_PASSWORD=CAMBIAR
MEDICAL_RECORDS_DB_PASSWORD=CAMBIAR
# Contraseña inicial del administrador de la aplicación.
MASTER_ADMIN_PASSWORD=CAMBIAR
# El servicio auth usa HS256: este secreto necesita 32 caracteres o más.
JWT_SECRET=CAMBIAR

DOCKERHUB_USER=benjamincubillosduoc
IMAGE_TAG=latest
CORS_ALLOWED_ORIGINS=https://hanrol.github.io
MASTER_ADMIN_EMAIL=admin@medireservas.local
MASTER_ADMIN_RUN=11.111.111-1
