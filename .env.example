# Local Compose credentials; replace all values before production use.
DB_ROOT_PASSWORD=change-this-root-password
AUTH_DB_PASSWORD=change-this-auth-password
USERS_DB_PASSWORD=change-this-users-password
DOCTORS_DB_PASSWORD=change-this-doctors-password
APPOINTMENTS_DB_PASSWORD=change-this-appointments-password
MEDICAL_RECORDS_DB_PASSWORD=change-this-medical-records-password
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
MYSQL_PORT=3311

# Master ADMIN account is created automatically by users-service on startup.
MASTER_ADMIN_EMAIL=admin@medireservas.local
MASTER_ADMIN_PASSWORD=Admin123!
MASTER_ADMIN_RUN=11.111.111-1
MASTER_ADMIN_FIRST_NAME=Administrador
MASTER_ADMIN_LAST_NAME=Maestro
MASTER_ADMIN_DEPARTMENT=Administración
MASTER_ADMIN_POSITION=Administrador maestro

# Production image registry and tag (Compose production only)
DOCKERHUB_USER=your-dockerhub-user
IMAGE_TAG=latest
